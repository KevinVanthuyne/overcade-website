<div class="bg-white">

    <section id="features"
             class="relative block px-8 py-12 md:py-20 md:px-10 bg-gray-50">

        <div class="relative mx-auto max-w-5xl text-center">
            <h2 class="text-sky-500 my-3 flex items-center justify-center font-semibold md:text-xl/relaxed tracking-wider">
                {{ site.data.t.home.features.eyebrow }}
            </h2>
            <span class="block w-full text-gray-900 font-bold text-3xl sm:text-4xl">
                {{ site.data.t.home.features.title }}
            </span>
            <p class="mx-auto my-4 w-full max-w-xl bg-transparent text-center
                        sm:text-xl/relaxed leading-relaxed tracking-wide text-gray-500">
                {{ site.data.t.home.features.lead }}
            </p>
        </div>


        <div class="relative mx-auto max-w-7xl z-10 grid grid-cols-1 gap-10 pt-10 md:pt-14 sm:grid-cols-2 lg:grid-cols-4">
            {% for feature in site.data.t.home.features.items %}
                {% include feature-card.html.liquid
                        icon=feature.icon
                        title=feature.title
                        content=feature.content %}
            {% endfor %}
        </div>

        <div class="absolute bottom-0 left-0 z-0 h-1/3 w-full border-b"
             style="background-image: linear-gradient(to right top, rgba(14, 165, 233, 0.2) 0%, transparent 50%, transparent 100%); border-color: rgba(14, 165, 233, 0.2);">
        </div>
        <div class="absolute bottom-0 right-0 z-0 h-1/3 w-full"
             style="background-image: linear-gradient(to left top, rgba(239, 68, 68, 0.2) 0%, transparent 50%, transparent 100%); border-color: rgba(239, 68, 68, 0.2);">
        </div>

    </section>
</div>