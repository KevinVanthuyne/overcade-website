<footer class="bg-white">
    <div class="mx-auto max-w-screen-xl space-y-8 px-4 py-16 sm:px-6 lg:space-y-16 lg:px-8">
        <div class="sm:flex sm:items-center sm:justify-between">
            <div class="mx-auto md:mx-0 w-40 hidden md:block">
                {% include logo/overcade-logo-with-text.svg %}
            </div>

            <ul class="mt-8 flex justify-center md:justify-start gap-6 sm:mt-0">
                {% include social-links.html.liquid size="size-10" %}
            </ul>
        </div>

        <div
                class="grid grid-cols-1 gap-8 border-t border-gray-100 pt-8 sm:grid-cols-2 lg:grid-cols-4 lg:pt-16  text-center md:text-left"
        >
            <div>
                <p class="font-medium text-gray-900">{{ site.data.t.footer.contact }}</p>

                <ul class="mt-6 space-y-4 text-sm text-gray-700">
                    <li><a href="mailto:info@overcade.be">info@overcade.be</a></li>
                    <li>+32 495 86 46 76</li>
                </ul>
            </div>

            <div class="mt-4 md:mt-0">
                <p class="font-medium text-gray-900">{{ site.data.t.footer.details }}</p>

                <ul class="mt-6 space-y-4 text-sm text-gray-700">
                    <li>Staf Bruggenstraat 26/001<br/>9040 Sint-Amandsberg (Gent)</li>
                    <li>BE1015.576.340</li>
                </ul>
            </div>


            <div class="mt-4 md:mt-0">
                <p class="font-medium text-gray-900">{{ site.data.t.footer.links }}</p>

                <ul class="mt-6 space-y-4 text-sm">
                    {% for item in site.data.navigation %}
                        <li>
                            <a href="{{ item.link }}"
                               class=" text-gray-700 transition hover:opacity-75">{{ item.name }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            <div class="mt-4 md:mt-0">
                <p class="font-medium text-gray-900">{{ site.data.t.footer.legal }}</p>

                <ul class="mt-6 space-y-4 text-sm">
                    <li>
                        <a href="/assets/docs/algemene-voorwaarden-overcade.pdf"
                           class="text-gray-700 transition hover:opacity-75"> {{ site.data.t.footer.terms }} </a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4 text-center md:text-left pt-12 md:pt-0">
            <div class="lg:col-start-2 text-xs text-gray-500">{{ site.data.t.footer.copyright }}</div>
            <div class="lg:col-start-3 text-xs text-gray-500">{{ site.data.t.footer.part_of }}</div>
        </div>
    </div>
</footer>