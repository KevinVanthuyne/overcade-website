<div class="inline-flex rounded-lg border border-gray-200 bg-white p-1 shadow-sm {{ include.class }}">
    <button type="button" data-card-size="large" title="{{ site.data.t.games.view_large }}"
            class="card-size-btn flex items-center rounded-md px-3 text-gray-500 transition-colors hover:text-gray-900">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="4" y="4" width="16" height="7" rx="1"></rect>
            <rect x="4" y="13" width="16" height="7" rx="1"></rect>
        </svg>
    </button>
    <button type="button" data-card-size="compact" title="{{ site.data.t.games.view_compact }}"
            class="card-size-btn flex items-center rounded-md px-3 text-gray-500 transition-colors hover:text-gray-900">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="4" y="4" width="7" height="7" rx="1"></rect>
            <rect x="13" y="4" width="7" height="7" rx="1"></rect>
            <rect x="4" y="13" width="7" height="7" rx="1"></rect>
            <rect x="13" y="13" width="7" height="7" rx="1"></rect>
        </svg>
    </button>
</div>
