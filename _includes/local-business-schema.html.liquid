{%- comment -%}
  Describes the business to search engines with the same name, address and phone
  number as the Google Maps profile, so Google can link the two.
{%- endcomment -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": "{{ site.url }}/#business",
    "name": "Overcade",
    "description": {{ site.description | jsonify }},
    "url": "{{ site.url }}/",
    "logo": "{{ site.url }}{{ site.logo }}",
    "image": "{{ site.url }}/assets/images/pac-man-in-office.JPG",
    "telephone": "+32495864676",
    "email": "info@overcade.be",
    "vatID": "BE1015576340",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Staf Bruggenstraat 26/001",
      "postalCode": "9040",
      "addressLocality": "Gent",
      "addressCountry": "BE"
    },
    "areaServed": { "@type": "Country", "name": "Belgium" },
    "sameAs": {{ site.social.links | jsonify }}
  }
</script>
